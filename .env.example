# ============================================================
# Supabase — database, auth, storage
# Create a project at https://supabase.com, run the migration in
# supabase/migrations/0001_init.sql against it, then create a private
# Storage bucket named "student-documents".
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public/browser client — only used for the read-only RLS-scoped fallback
# (active programs + active knowledge_base). Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# AI layer — $0 MVP setup, provider-agnostic with automatic failover:
#   Gemini (primary, free tier) -> OpenRouter (fallback, free tier)
#   -> safe human-advisor fallback (never a paid model, never a guess).
# At least one of GEMINI_API_KEY / OPENROUTER_API_KEY must be set.
# Setting both gives you the failover; either alone still works.
# See docs/ARCHITECTURE.md "AI layer" for the full design.
# ============================================================

# Google Gemini — https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
# Any model currently on Gemini's free tier — verify at
# https://ai.google.dev/gemini-api/docs/pricing before relying on it,
# since Google renames/retires free-tier models over time.
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter — https://openrouter.ai/keys (fallback; use a free model)
OPENROUTER_API_KEY=
# Must end in ":free" (OpenRouter's free-tier naming convention) or the
# app refuses to call it, to guarantee this MVP can never incur cost by
# accident. Browse current free models at
# https://openrouter.ai/models?max_price=0 — the exact free roster
# rotates, so re-verify this default periodically.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Only set to "true" if you deliberately want to allow a non-":free"
# OPENROUTER_MODEL (e.g. a paid model you're intentionally paying for).
OPENROUTER_ALLOW_PAID_MODEL=false

# ============================================================
# n8n — automation layer (notifications, follow-ups, CRM sync)
# Each is an n8n Webhook node URL. Leave unset to no-op that event.
# ============================================================
N8N_WEBHOOK_URL_LEAD_CREATED=
N8N_WEBHOOK_URL_HOT_LEAD=
N8N_WEBHOOK_URL_APPLICATION_EVENT=

# ============================================================
# Admin dashboard — MVP shared-secret auth (see docs/ARCHITECTURE.md
# for the recommended production replacement: Supabase Auth + RLS)
# ============================================================
ADMIN_TOKEN=
